local L = require("../../src/shared/EnemyLife")
return function(t)
	local function boss()
		return { hp = 100, maxHp = 100, shield = 30, regen = 5, alive = true }
	end
	t.test("shield absorbs, not dead", function()
		local e = boss()
		local d, k = L.hit(e, 20)
		t.eq(d, 20); t.eq(k, false); t.eq(e.shield, 10); t.eq(e.hp, 100)
	end)
	t.test("lethal hit marks dead synchronously, clamps hp", function()
		local e = boss()
		local d, k = L.hit(e, 500)
		t.eq(k, true); t.eq(e.alive, false); t.eq(e.hp, 0); t.eq(d, 130)
	end)
	t.test("exact zero kills", function()
		local e = boss()
		local _, k = L.hit(e, 130)
		t.eq(k, true); t.eq(L.targetable(e), false)
	end)
	t.test("no double kill / overkill after death", function()
		local e = boss()
		L.hit(e, 500)
		local d, k = L.hit(e, 500)
		t.eq(d, 0); t.eq(k, false)
	end)
	t.test("regen never revives", function()
		local e = boss()
		L.hit(e, 500)
		t.eq(L.regen(e, 10), false); t.eq(e.hp, 0); t.eq(e.alive, false)
	end)
	t.test("regen heals living, capped", function()
		local e = boss()
		L.hit(e, 50)
		L.regen(e, 1); t.eq(e.hp, 85)
		L.regen(e, 100); t.eq(e.hp, 100)
	end)
	t.test("shield alone never keeps target alive", function()
		local e = { hp = 0, maxHp = 10, shield = 50, regen = 0, alive = true }
		t.eq(L.targetable(e), false)
		t.eq(L.targetable(nil), false)
	end)
end
