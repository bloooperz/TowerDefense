local SR = require("../../src/shared/SummonReveal")
local def = { name = "Basic", rarity = "Rare", damage = 20, rate = 0.5, range = 18 }
local traits = { Sharp = { id = "Sharp", name = "Sharp", desc = "Hits harder." } }
return function(t)
	t.test("plain result: base stats, no trait/grades/sold", function()
		local m = SR.card({ unitId = "basic", rarity = "Rare", uid = "u1" }, def, traits)
		t.eq(m.name, "Basic"); t.eq(m.rarity, "Rare"); t.eq(#m.stats, 3)
		t.eq(m.stats[1].value, "20"); t.eq(m.stats[2].value, "0.5s"); t.eq(m.stats[3].value, "18")
		t.eq(m.trait, nil); t.eq(m.grades, nil); t.eq(m.soldText, nil)
	end)
	t.test("trait 'None' stays hidden; real trait shown", function()
		t.eq(SR.card({ unitId = "basic", trait = "None" }, def, traits).trait, nil)
		local m = SR.card({ unitId = "basic", trait = "Sharp" }, def, traits)
		t.eq(m.trait.name, "Sharp"); t.eq(m.trait.desc, "Hits harder.")
	end)
	t.test("grades mapping and ordering", function()
		t.eq(SR.grade("ss"), "SS"); t.eq(SR.grade("Z"), "Z"); t.eq(SR.grade("Q"), nil); t.eq(SR.grade(nil), nil)
		t.eq(SR.GRADE_RANK.C < SR.GRADE_RANK.Z, true); t.eq(#SR.GRADES, 6)
		local m = SR.card({ unitId = "basic", stats = { range = "B", damage = "S", cooldown = "x" } }, def, traits)
		t.eq(#m.grades, 2); t.eq(m.grades[1].key, "damage"); t.eq(m.grades[1].grade, "S"); t.eq(m.grades[2].grade, "B")
		t.eq(SR.card({ unitId = "basic", stats = {} }, def, traits).grades, nil)
	end)
	t.test("auto-sold tag", function()
		t.eq(SR.card({ unitId = "basic", sold = 25 }, def, traits).soldText, "Auto-sold +25 Gold")
	end)
	t.test("missing def does not show 'Label' or crash", function()
		local m = SR.card({ unitId = "ghost" }, nil, traits)
		t.eq(m.name, "ghost"); t.eq(m.rarity, "Common"); t.eq(#m.stats, 0)
	end)
	t.test("cards: one per result, in order, left to right, staggered", function()
		local res = { { unitId = "a" }, { unitId = "b" }, { unitId = "c" } }
		local vm = SR.layout(res, false, function() return def end, traits)
		t.eq(#vm.cards, 3); t.eq(vm.empty, false)
		for i, m in ipairs(vm.cards) do
			t.eq(m.order, i); t.eq(m.hasModel, true); t.eq(m.flame, true)
			t.eq(math.abs(m.delay - (i - 1) * SR.STAGGER) < 1e-9, true)
		end
		t.eq(SR.STAGGER >= 0.05 and SR.STAGGER <= 0.1, true)
		t.eq(vm.cards[2].delay > vm.cards[1].delay, true)
		t.eq(SR.layout({}, false).empty, true)
	end)
	t.test("auto-sold tag only on auto-sold cards; skip setting = no stagger", function()
		local vm = SR.layout({ { unitId = "a" }, { unitId = "b", sold = 10 }, { unitId = "c" } }, false, function() return def end, traits)
		t.eq(vm.cards[1].sold, false); t.eq(vm.cards[2].sold, true); t.eq(vm.cards[3].sold, false)
		t.eq(vm.cards[2].soldText, "Auto-sold +10 Gold"); t.eq(vm.cards[1].soldText, nil)
		local q = SR.layout({ { unitId = "a" }, { unitId = "b" } }, true)
		t.eq(q.cards[2].delay, 0); t.eq(q.cards[2].flame, false)
	end)
	t.test("SR.sequence (Next/Skip step-through) is gone", function()
		t.eq(SR.sequence, nil)
	end)
	t.test("click outside a model dismisses; on a model does not", function()
		local c = SR.clicks()
		c.press("other"); t.eq(c.release(true), true)
		c.press("model"); t.eq(c.release(true), false)
		c.press("button"); t.eq(c.release(true), false) -- summon row does its own action
		c.press("other"); t.eq(c.release(false), false) -- hidden: nothing to dismiss
	end)
	t.test("press that started on a card never dismisses", function()
		local c = SR.clicks()
		c.press("model") -- released over empty band space
		t.eq(c.release(true), false)
		t.eq(c.release(true), false) -- no stale press
	end)
	t.test("summon button: dismiss while showing, summon while hidden (alternating)", function()
		local c = SR.clicks()
		t.eq(c.summonClick(true), "dismiss")
		t.eq(c.summonClick(false), "summon")
		t.eq(c.summonClick(true), "dismiss")
	end)
	t.test("popup wiring: no Close buttons, summon row lifted above popup", function()
		local fs = require("@lune/fs")
		local s = fs.readFile("src/client/Lobby/SummonUI.luau")
		t.eq(s:find('bigBtn("Close"', 1, true), nil)
		t.eq(s:find("closeX", 1, true), nil)
		t.eq(s:find("Theme.panel(box", 1, true), nil) -- no boxed summary frame
		t.eq(s:find('Name = "SummonReveal", BorderSizePixel = 0', 1, true) ~= nil, true)
		t.eq(s:find("clicks.summonClick(showing())", 1, true) ~= nil, true)
		t.eq(s:find("row.Parent, row.AnchorPoint, row.ZIndex = pop", 1, true) ~= nil, true)
	end)
	t.test("card popup wiring: band, viewport per card, no Next/Skip/Spin", function()
		local fs = require("@lune/fs")
		local s = fs.readFile("src/client/Lobby/SummonUI.luau")
		t.eq(s:find("Next", 1, true), nil); t.eq(s:find('"Skip"', 1, true), nil)
		t.eq(s:find("Spin", 1, true), nil); t.eq(s:find("[Space]", 1, true), nil)
		t.eq(s:find('Name = "Band"', 1, true) ~= nil, true)
		t.eq(s:find("Card.portrait(def, c)", 1, true) ~= nil, true) -- ViewportFrame inside each card
		t.eq(s:find("ClipsDescendants = true", 1, true) ~= nil, true)
		t.eq(s:find("task.delay(m.delay", 1, true) ~= nil, true)
		t.eq(s:find("SummonReveal.layout(", 1, true) ~= nil, true)
		t.eq(s:find("Rewards obtained", 1, true) ~= nil, true)
	end)
	t.test("layout: summon button row sits below the results band at any screen height", function()
		for _, h in ipairs({ 284, 360, 540, 720, 1080, 1440 }) do
			local _, bandBottom = SR.bandRect(h)
			local rowTop, rowBottom = SR.rowRect(h)
			t.eq(rowTop > bandBottom, true); t.eq(rowBottom <= h, true)
		end
		t.eq(SR.buttonText(50, 2500), "x50  2500 Gems")
	end)
	t.test("layout wiring: band/row use the shared rects, fixed button widths, HUD hidden", function()
		local fs = require("@lune/fs")
		local s = fs.readFile("src/client/Lobby/SummonUI.luau")
		t.eq(s:find("Size = UDim2.new(1, 0, SR.BAND_SCALE, -SR.BAR)", 1, true) ~= nil, true)
		t.eq(s:find("UDim2.new(0.5, 0, 0.5, -SR.BAR / 2)", 1, true) ~= nil, true)
		t.eq(s:find("row.Position = UDim2.new(1, -SR.ROW_MARGIN, 1, -SR.ROW_MARGIN)", 1, true) ~= nil, true)
		t.eq(s:find("UDim2.fromOffset(SR.BTN_W, SR.ROW_H)", 1, true) ~= nil, true)
		t.eq(s:find("hidden[c], c.Visible = true, false", 1, true) ~= nil, true)
		local card = fs.readFile("src/client/UI/Card.luau")
		t.eq(card:find("Color = Card.modelColor(u)", 1, true) ~= nil, true)
	end)
	t.test("featured: three banner units, rarest in the emphasized center", function()
		local r = { a = 2, b = 3, c = 2 }
		local f = SR.featured({ "a", "b", "c" }, function(id) return r[id] end)
		t.eq(#f, 3); t.eq(f[2].id, "b"); t.eq(f[2].emphasized, true)
		t.eq(f[1].emphasized, false); t.eq(f[3].emphasized, false); t.eq(f[1].id, "a"); t.eq(f[3].id, "c")
		t.eq(#SR.featured({}, function() return 0 end), 0)
	end)
	t.test("banner screen wiring: full-screen, featured viewports, HUD layout", function()
		local fs = require("@lune/fs")
		local s = fs.readFile("src/client/Lobby/SummonUI.luau")
		t.eq(s:find("root.Size, root.Position, root.AnchorPoint = UDim2.fromScale(1, 1)", 1, true) ~= nil, true)
		t.eq(s:find('Name = "Backdrop"', 1, true) ~= nil, true)
		t.eq(s:find('Name = "Featured"', 1, true) ~= nil, true)
		t.eq(s:find("local vp = Card.portrait(def, slot)", 1, true) ~= nil, true)
		t.eq(s:find("SummonReveal.featured(banner.units, rank)", 1, true) ~= nil, true)
		t.eq(s:find('Text = "Summon"', 1, true) ~= nil, true)
		t.eq(s:find('Name = "Pity"', 1, true) ~= nil, true)
		t.eq(s:find('Name = "Gems"', 1, true) ~= nil, true)
		t.eq(s:find("Rates.button(root", 1, true) ~= nil, true)
		t.eq(s:find("Card.new(def, 1, cards)", 1, true), nil) -- small boxed cards gone
	end)
	t.test("screen: root covers full viewport incl. topbar inset; safe content below inset", function()
		local fs = require("@lune/fs")
		for _, inset in ipairs({ 0, 36, 58, 116 }) do -- 116 ~ 4K at 2x UI scale
			local g = SR.screen(inset)
			t.eq(g.root.sx, 1); t.eq(g.root.sy, 1); t.eq(g.root.oy, inset); t.eq(g.root.poy, -inset / 2)
			t.eq(g.safe.sx, 1); t.eq(g.safe.sy, 1); t.eq(g.safe.oy, -inset); t.eq(g.safe.poy, inset)
			-- simulated viewport H = 2160: root top = gui top(inset) + (H-inset)/2 + poy - (H)/2 ... = 0
			local H = 2160
			local guiH = H - inset
			local rootH = guiH + g.root.oy
			local rootTop = inset + guiH / 2 + g.root.poy - rootH / 2
			t.eq(rootTop, 0); t.eq(rootTop + rootH, H)
			t.eq(rootTop + g.safe.poy, inset) -- content starts below the topbar
		end
		local s = fs.readFile("src/client/Lobby/SummonUI.luau")
		t.eq(s:find('Name = "Backdrop", BorderSizePixel = 0, Size = UDim2.fromScale(1, 1)', 1, true) ~= nil, true)
		t.eq(s:find("GuiService:GetGuiInset()", 1, true) ~= nil, true)
		t.eq(s:find('Name = "Safe"', 1, true) ~= nil, true)
		t.eq(s:find('SetAttribute("SummonOpen", root.Visible)', 1, true) ~= nil, true)
		local st = fs.readFile("src/client/Settings/SettingsUI.luau")
		t.eq(st:find('holder.Visible = player:GetAttribute("SummonOpen") ~= true', 1, true) ~= nil, true)
	end)
end
