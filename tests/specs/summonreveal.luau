local SR = require("../../src/shared/SummonReveal")
local def = { name = "Basic", rarity = "Rare", damage = 20, rate = 0.5, range = 18 }
local traits = { Sharp = { id = "Sharp", name = "Sharp", desc = "Hits harder." } }
return function(t)
	t.test("plain result: base stats, no trait/grades/sold", function()
		local m = SR.card({ unitId = "basic", rarity = "Rare", uid = "u1" }, def, traits)
		t.eq(m.name, "Basic"); t.eq(m.rarity, "Rare"); t.eq(#m.stats, 3)
		t.eq(m.stats[1].value, "20"); t.eq(m.stats[2].value, "0.5s"); t.eq(m.stats[3].value, "18")
		t.eq(m.trait, nil); t.eq(m.grades, nil); t.eq(m.soldText, nil)
	end)
	t.test("trait 'None' stays hidden; real trait shown", function()
		t.eq(SR.card({ unitId = "basic", trait = "None" }, def, traits).trait, nil)
		local m = SR.card({ unitId = "basic", trait = "Sharp" }, def, traits)
		t.eq(m.trait.name, "Sharp"); t.eq(m.trait.desc, "Hits harder.")
	end)
	t.test("grades mapping and ordering", function()
		t.eq(SR.grade("ss"), "SS"); t.eq(SR.grade("Z"), "Z"); t.eq(SR.grade("Q"), nil); t.eq(SR.grade(nil), nil)
		t.eq(SR.GRADE_RANK.C < SR.GRADE_RANK.Z, true); t.eq(#SR.GRADES, 6)
		local m = SR.card({ unitId = "basic", stats = { range = "B", damage = "S", cooldown = "x" } }, def, traits)
		t.eq(#m.grades, 2); t.eq(m.grades[1].key, "damage"); t.eq(m.grades[1].grade, "S"); t.eq(m.grades[2].grade, "B")
		t.eq(SR.card({ unitId = "basic", stats = {} }, def, traits).grades, nil)
	end)
	t.test("auto-sold tag", function()
		t.eq(SR.card({ unitId = "basic", sold = 25 }, def, traits).soldText, "Auto-sold +25 Gold")
	end)
	t.test("missing def does not show 'Label' or crash", function()
		local m = SR.card({ unitId = "ghost" }, nil, traits)
		t.eq(m.name, "ghost"); t.eq(m.rarity, "Common"); t.eq(#m.stats, 0)
	end)
	t.test("multi sequence: next through, then summary", function()
		local s = SR.sequence({ { unitId = "a" }, { unitId = "b" }, { unitId = "c" } }, false)
		t.eq(s.mode, "reveal"); t.eq(s.current().unitId, "a"); t.eq(s.counter(), "1 / 3"); t.eq(s.showSkip(), true)
		s.next(); t.eq(s.current().unitId, "b"); s.next(); t.eq(s.current().unitId, "c")
		t.eq(s.next(), "summary"); t.eq(s.current(), nil); t.eq(s.next(), "summary")
	end)
	t.test("skip jumps to summary; skip setting starts in summary", function()
		local s = SR.sequence({ { unitId = "a" }, { unitId = "b" } }, false)
		t.eq(s.skip(), "summary"); t.eq(s.showSkip(), false)
		t.eq(SR.sequence({ { unitId = "a" } }, true).mode, "summary")
		local one = SR.sequence({ { unitId = "a" } }, false)
		t.eq(one.showSkip(), false); t.eq(one.next(), "summary")
		t.eq(SR.sequence({}, false).mode, "empty")
	end)
end
