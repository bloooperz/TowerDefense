local Damage = require("../../src/shared/Damage")
return function(t)
	t.test("base damage", function()
		t.near((Damage.compute(100)), 100)
	end)
	t.test("armor and pen", function()
		t.near((Damage.compute(100, { armor = 0.4 })), 60)
		t.near((Damage.compute(100, { armor = 0.4, armorPen = 0.25 })), 85)
		t.near((Damage.compute(100, { armor = 0.2, armorPen = 0.5 })), 100)
	end)
	t.test("armor capped", function()
		t.near((Damage.compute(100, { armor = 5 })), 10)
	end)
	t.test("crit uses roll", function()
		local a, c = Damage.compute(10, { critChance = 0.5, critMult = 3, roll = 0.1 })
		t.near(a, 30); t.eq(c, true)
		local b, c2 = Damage.compute(10, { critChance = 0.5, critMult = 3, roll = 0.9 })
		t.near(b, 10); t.eq(c2, false)
	end)
	t.test("shield absorbs first", function()
		local s, hp, dealt = Damage.applyToPools(50, 30, 100)
		t.near(s, 0); t.near(hp, 80); t.near(dealt, 20)
	end)
end
