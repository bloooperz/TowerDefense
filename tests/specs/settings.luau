local S = require("../../src/shared/Settings")
local K = require("../../src/shared/Keybinds")
return function(ctx)
	local t, eq = ctx.test, ctx.eq
	t("settings: nil -> defaults, no problems", function()
		local s, p = S.sanitize(nil, K)
		eq(s.damageNumbers, true); eq(s.music, 0.5); eq(#p, 0); eq(s.version, S.VERSION)
	end)
	t("settings: bad types reset + reported, volumes clamped, unknown dropped", function()
		local s, p = S.sanitize({ lowGraphics = "yes", music = 5, sfx = -1, evil = true }, K)
		eq(s.lowGraphics, false); eq(s.music, 1); eq(s.sfx, 0); eq(s.evil, nil); eq(#p, 1)
	end)
	t("settings: NaN volume rejected", function()
		local s, p = S.sanitize({ music = 0 / 0 }, K)
		eq(s.music, 0.5); eq(#p, 1)
	end)
	t("keybinds: resolve defaults + override", function()
		local m = K.resolve({ cancel = "X" })
		eq(m.cancel, "X"); eq(m.hotbar1, "One"); eq(m.dev, "F2")
	end)
	t("keybinds: rebind rejects duplicate", function()
		local o, why = K.rebind({}, "cancel", "One")
		eq(o, nil); assert(why:find("already bound"), why)
	end)
	t("keybinds: rebind rejects Escape, accepts free key, default removes override", function()
		eq((K.rebind({}, "cancel", "Escape")), nil)
		local o = K.rebind({}, "cancel", "X")
		eq(o.cancel, "X")
		eq(K.rebind(o, "cancel", "Q").cancel, nil)
	end)
	t("keybinds: sanitize drops unknown/bad/duplicate", function()
		local c, p = K.sanitize({ nope = "Z", cancel = "bad key!", hotbar2 = "One" })
		eq(c.nope, nil); eq(c.cancel, nil); eq(c.hotbar2, nil); assert(#p >= 3)
		local m = K.resolve(c)
		eq(m.hotbar1, "One"); eq(m.hotbar2, "Two")
	end)
	t("keybinds: swap via sanitize keeps map unique", function()
		local c = K.sanitize({ hotbar1 = "Two", hotbar2 = "One" })
		local m, seen = K.resolve(c), {}
		for _, k in pairs(m) do
			assert(not seen[k], "dup " .. k); seen[k] = true
		end
	end)
end
