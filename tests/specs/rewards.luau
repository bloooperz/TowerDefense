local R = require("../../src/shared/Rewards")
local PL = require("../../src/shared/PlayerLevel")
return function(t)
	t.test("loss pays half of wave portion", function()
		local win = R.compute({ wavesCleared = 10, won = true })
		local loss = R.compute({ wavesCleared = 10, won = false })
		t.eq(win.gems, 100); t.eq(loss.gems, 25)
	end)
	t.test("zero waves still pays something", function()
		t.eq(R.compute({ wavesCleared = 0, won = false }).gems, 1)
	end)
	t.test("cap", function()
		t.eq(R.compute({ wavesCleared = 1000, won = true }).gems, R.GEM_CAP)
	end)
	t.test("player level progress (PlayerLevel)", function()
		t.eq(PL.levelForXp(399), 2); t.eq(PL.levelForXp(400), 3); t.eq(PL.xpForLevel(1), 0); t.eq(PL.xpForLevel(3), 400)
		for xp = 0, 3000, 37 do
			local _, a, n = PL.progress(xp)
			assert(a >= 0 and a < n, "progress in range at " .. xp)
		end
	end)
end
