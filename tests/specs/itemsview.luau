local fs = require("@lune/fs")
local IV = require("../../src/shared/ItemsView")
local InventoryView = require("../../src/shared/InventoryView")
return function(t)
	t.test("items view: loading, empty, mapping", function()
		local l = IV.view(nil); t.eq(l.loading, true); t.eq(l.message, IV.LOADING)
		local e = IV.view({}); t.eq(#e.rows, 0); t.eq(e.message, IV.EMPTY)
		local v = IV.view({ XpFoodL = 2, XpFoodS = 5, Mystery = 1, XpFoodM = 0 })
		t.eq(#v.rows, 3); t.eq(v.message, nil); t.eq(v.header, "Items: 8")
		t.eq(v.rows[1].id, "XpFoodS"); t.eq(v.rows[1].name, "Small XP Snack"); t.eq(v.rows[1].count, 5)
		t.eq(v.rows[1].category, "XP Food"); t.eq(v.rows[1].countText, "x5")
		t.eq(v.rows[2].id, "XpFoodL"); t.eq(v.rows[3].category, "Other"); t.eq(v.rows[3].name, "Mystery")
		t.eq(v.rows[1].tooltip:find("+500 unit XP", 1, true) ~= nil, true)
		t.eq(IV.category("portal"), "Portal"); t.eq(IV.category("material"), "Material")
	end)
	t.test("unit sidebar: Feed/Fuse added, coming-soon only", function()
		t.eq(table.concat(InventoryView.ACTIONS, ","), "Equip,Sell,Lock,View,Feed,Fuse")
		t.eq(InventoryView.COMING_SOON.Feed and InventoryView.COMING_SOON.Fuse, true)
		t.eq(InventoryView.COMING_SOON.Lock, nil); t.eq(InventoryView.COMING_SOON.View, nil)
		local u = fs.readFile("src/client/Lobby/UnitsUI.luau")
		t.eq(u:find("Net.", 1, true), nil) -- no server calls from the units panel
	end)
	t.test("panel wiring: I = items, K = units, old feeding UI gone", function()
		local l = fs.readFile("src/client/Lobby/LobbyUI.luau")
		t.eq(l:find("require(script.Parent.UnitsUI).build(panels.Units)", 1, true) ~= nil, true)
		t.eq(l:find("require(script.Parent.ItemsUI).build(panels.Inventory)", 1, true) ~= nil, true)
		t.eq(l:find("InventoryUI", 1, true), nil)
		local p = fs.readFile("src/client/Lobby/Progression.luau")
		for _, s in ipairs({ "buildUnits", "UseItem", "FuseUnits", "SellOwnedUnit" }) do
			t.eq(p:find(s, 1, true), nil)
		end
		t.eq(fs.readFile("src/client/Lobby/ItemsUI.luau"):find("Net.", 1, true), nil) -- read-only
	end)
end
