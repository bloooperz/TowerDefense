local L = require("../../src/shared/EnemyLabel")
return function(t)
	t.test("compact HP formatting", function()
		t.eq(L.compact(0), "0"); t.eq(L.compact(950), "950"); t.eq(L.compact(999.2), "1K")
		t.eq(L.compact(1234), "1.2K"); t.eq(L.compact(1000), "1K"); t.eq(L.compact(15000), "15K")
		t.eq(L.compact(2500000), "2.5M"); t.eq(L.compact(0.3), "1"); t.eq(L.compact(-5), "0")
		t.eq(L.hp(120, 200), "120 / 200"); t.eq(L.hp(1500, 12000), "1.5K / 12K")
	end)
	t.test("type name from def (display name, then id)", function()
		t.eq(L.name({ id = "Basic", name = "Grunt" }), "Grunt"); t.eq(L.name({ id = "Boss" }), "Boss")
		t.eq(L.name(nil), "Enemy")
		for _, id in ipairs({ "Basic", "Fast", "Boss", "Tank", "Flying" }) do
			local src = require("@lune/fs").readFile("src/shared/Enemies/" .. id .. ".luau")
			t.eq(src:find("name = ", 1, true) ~= nil, true)
		end
	end)
	t.test("billboard wiring: real text at spawn, updated only on the 2% bar step", function()
		local s = require("@lune/fs").readFile("src/server/Enemies.luau")
		t.eq(s:find("EnemyLabel.name(e.def)", 1, true) ~= nil, true)
		t.eq(s:find("outlined(g, 14, 12, EnemyLabel.hp(e.hp, e.maxHp)", 1, true) ~= nil, true)
		t.eq(s:find("if e.hpText and t ~= e.hpText.Text then", 1, true) ~= nil, true)
		t.eq(s:find("g.MaxDistance = 140", 1, true) ~= nil, true)
		t.eq(s:find("TextStrokeTransparency = 1, 1", 1, true), nil)
		t.eq(s:find("RenderStepped", 1, true), nil); t.eq(s:find("Heartbeat", 1, true), nil)
	end)
end
