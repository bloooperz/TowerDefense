local S = require("../../src/shared/StatusLogic")
return function(t)
	t.test("slow: strongest wins, duration extends", function()
		local st = S.new()
		S.apply(st, "slow", { amount = 0.3, duration = 2 }, 0)
		S.apply(st, "slow", { amount = 0.5, duration = 1 }, 0)
		t.near(S.speedMult(st, 0.5), 0.5)
		t.near(st.slow.expires, 2)
	end)
	t.test("stun overrides slow and boss halves", function()
		local st = S.new()
		S.apply(st, "slow", { amount = 0.3, duration = 5 }, 0)
		S.apply(st, "stun", { duration = 2 }, 0, { boss = true })
		t.near(S.speedMult(st, 0.5), 0)
		t.near(S.speedMult(st, 1.5), 0.7)
	end)
	t.test("burn stacks capped and prune", function()
		local st = S.new()
		for i = 1, 7 do
			S.apply(st, "burn", { dps = 10, duration = i }, 0)
		end
		t.eq(#st.burn.stacks, 5)
		t.eq(#S.dots(st, 0), 5)
		S.prune(st, 100)
		t.eq(st.burn, nil)
	end)
	t.test("prune reports changes", function()
		local st = S.new()
		S.apply(st, "stun", { duration = 1 }, 0)
		t.eq(S.prune(st, 0.5), false)
		t.eq(S.prune(st, 2), true)
		t.near(S.speedMult(st, 2), 1)
	end)
end
