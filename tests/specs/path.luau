local Path = require("../../src/shared/Path")
return function(t)
	local V = t.V
	local p = Path.new({ V.new(0, 0, 0), V.new(10, 0, 0), V.new(10, 0, 10) })
	t.test("length sums segments", function()
		t.near(p.length, 20)
	end)
	t.test("positionAt on first segment", function()
		local pos = p:positionAt(5)
		t.near(pos.X, 5); t.near(pos.Z, 0)
	end)
	t.test("positionAt on second segment + dir", function()
		local pos, dir = p:positionAt(15)
		t.near(pos.X, 10); t.near(pos.Z, 5); t.near(dir.Z, 1)
	end)
	t.test("positionAt clamps", function()
		t.near(p:positionAt(-5).X, 0)
		t.near(p:positionAt(99).Z, 10)
	end)
	t.test("nearest returns along + offset", function()
		local along, off = p:nearest(V.new(5, 3, 2))
		t.near(along, 5); t.near(off, 2)
		local a2, o2 = p:nearest(V.new(13, 0, 7))
		t.near(a2, 17); t.near(o2, 3)
	end)
end
