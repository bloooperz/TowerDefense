local fs = require("@lune/fs")
local Summon = require("../../src/shared/Summon")
return function(t)
	t.test("cooldown is 0.5s: blocked within, allowed after", function()
		t.eq(Summon.COOLDOWN, 0.5)
		t.eq(Summon.cooldownReady(nil, 0), true)
		t.eq(Summon.cooldownReady(10, 10.1), false)
		t.eq(Summon.cooldownReady(10, 10.49), false)
		t.eq(Summon.cooldownReady(10, 10.5), true)
		t.eq(Summon.cooldownReady(10, 11), true)
	end)
	t.test("server: silent cooldown, old rate=1 limit gone; client gated too", function()
		local net = fs.readFile("src/shared/Net.luau")
		t.eq(net:find('Summon = { dir = "c2s", args = { "number" }, rate = 1 }', 1, true), nil)
		local m = fs.readFile("src/server/Match.luau")
		t.eq(m:find("if not Summon.cooldownReady(lastSummon[plr.UserId], os.clock()) then\n\t\t\treturn nil", 1, true) ~= nil, true)
		t.eq(fs.readFile("src/client/Lobby/SummonUI.luau"):find("Summon.cooldownReady(lastSent, os.clock())", 1, true) ~= nil, true)
	end)
end
